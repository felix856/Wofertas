# ========== CONFIGURAÇÃO RPA PYTHON ==========

# URL da API REST Java
WOFERTAS_API_URL=http://localhost:8080/api

# Credenciais para testar (use credenciais reais em produção)
WOFERTAS_USER_EMAIL=dev@localhost
WOFERTAS_USER_PASSWORD=devpass123

# Banco de Dados MongoDB
MONGODB_URI=mongodb+srv://dev_user:dev_password@localhost/wofertas-dev

# IA Coach - Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Configuração de Agendamento
CACHE_SYNC_INTERVAL_MINUTES=5
RECOMMENDATIONS_INTERVAL_MINUTES=60

# Logging
LOG_LEVEL=INFO
LOG_FILE=wofertas_rpa.log
