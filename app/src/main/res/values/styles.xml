<?xml version="1.0" encoding="utf-8"?>
<resources>



    <!-- ── Botões (nomes canônicos usados em layouts antigos) ── -->
    <style name="Btn.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/wofertas_blue_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Btn.Secondary" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="backgroundTint">@color/wofertas_yellow</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Btn.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/wofertas_blue_primary</item>
        <item name="strokeColor">@color/wofertas_blue_primary</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Btn.Danger" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/status_suspenso</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- ── Aliases Wofertas.Button.* (usados em activity_main, activity_login) ── -->
    <!-- FIX: activity_main.xml e activity_login.xml referenciam esses nomes     -->
    <style name="Wofertas.Button.Primary"   parent="Btn.Primary" />
    <style name="Wofertas.Button.Secondary" parent="Btn.Secondary" />
    <style name="Wofertas.Button.Outline"   parent="Btn.Outline" />
    <style name="Wofertas.Button.Danger"    parent="Btn.Danger" />

    <!-- ── Labels ── -->
    <style name="SectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_hint</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="FieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:layout_marginBottom">5dp</item>
    </style>

</resources>