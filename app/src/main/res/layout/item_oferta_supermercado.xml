<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Logo do supermercado -->
        <!-- FIX: contentDescription → @string; touch target 48dp -->
        <ImageView
            android:id="@+id/imgOfertaSupermercado"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/cd_logo_supermercado"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/logo_supermercado_placeholder" />

        <!-- Título da oferta -->
        <TextView
            android:id="@+id/txtTituloOfertaSupermercado"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            app:layout_constraintStart_toEndOf="@id/imgOfertaSupermercado"
            app:layout_constraintTop_toTopOf="@id/imgOfertaSupermercado"
            app:layout_constraintEnd_toStartOf="@+id/chipStatus"
            tools:text="Encarte da Semana" />

        <!-- FIX: chipBackgroundColor → status_ativo (#00875A) para contraste suficiente;
                  text → @string; textColor branco mantém contraste ≥ 4.5:1 -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipStatus"
            android:layout_width="68dp"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:text="@string/status_ativo"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            app:chipBackgroundColor="@color/status_ativo"
            app:layout_constraintBottom_toTopOf="@+id/txtDescricaoOfertaSupermercado"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="TouchTargetSizeCheck"
            tools:text="ATIVO" />

        <!-- Subtítulo / nome supermercado -->
        <TextView
            android:id="@+id/txtDescricaoOfertaSupermercado"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            app:layout_constraintStart_toEndOf="@id/imgOfertaSupermercado"
            app:layout_constraintTop_toBottomOf="@id/txtTituloOfertaSupermercado"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="SantoAmaro Atacadista" />

        <!-- FIX: textColor → #757575 (contraste 4.6:1 sobre branco, passa WCAG AA) -->
        <TextView
            android:id="@+id/txtDataEnvio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:textColor="#616161"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imgOfertaSupermercado"
            app:layout_constraintTop_toBottomOf="@id/txtDescricaoOfertaSupermercado"
            tools:text="Enviado em: 31/07/2025" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/contentBottomBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="imgOfertaSupermercado,txtTituloOfertaSupermercado,txtDescricaoOfertaSupermercado,txtDataEnvio" />

        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="#EEEEEE"
            app:layout_constraintTop_toBottomOf="@id/contentBottomBarrier"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- FIX: todos os botões → 48dp (touch target mínimo); contentDescription → @string -->
        <ImageView
            android:id="@+id/imgViewPdf"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/cd_ver_encarte"
            android:src="@drawable/ic_pdf"
            android:padding="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageView
            android:id="@+id/imgEdit"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/cd_editar_oferta"
            android:src="@drawable/ic_edit"
            android:padding="4dp"
            app:layout_constraintStart_toEndOf="@id/imgViewPdf"
            app:layout_constraintTop_toTopOf="@id/imgViewPdf"
            app:layout_constraintBottom_toBottomOf="@id/imgViewPdf" />

        <!-- FIX: src → drawable próprio (ic_toggle_status) em vez de @android:drawable hardcoded -->
        <ImageView
            android:id="@+id/imgToggleStatus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/cd_alterar_status"
            android:src="@drawable/ic_toggle_status"
            android:padding="4dp"
            app:layout_constraintStart_toEndOf="@id/imgEdit"
            app:layout_constraintTop_toTopOf="@id/imgViewPdf"
            app:layout_constraintBottom_toBottomOf="@id/imgViewPdf" />

        <ImageView
            android:id="@+id/imgDelete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/cd_excluir_oferta"
            android:src="@drawable/ic_delete"
            android:padding="4dp"
            app:layout_constraintStart_toEndOf="@id/imgToggleStatus"
            app:layout_constraintTop_toTopOf="@id/imgViewPdf"
            app:layout_constraintBottom_toBottomOf="@id/imgViewPdf" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>