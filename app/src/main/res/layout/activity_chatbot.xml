<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarChatbot"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/wofertas_blue_primary"
        android:minHeight="?attr/actionBarSize"
        app:contentInsetEnd="16dp"
        app:contentInsetStartWithNavigation="16dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/white"
        app:subtitleTextColor="@color/wofertas_yellow_light"
        app:titleTextColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <HorizontalScrollView
        android:id="@+id/quickActionsScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:contentDescription="@string/chatbot_quick_questions_content_description"
        android:fadeScrollbars="false"
        android:fillViewport="false"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/toolbarChatbot"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickOne"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:text="@string/chatbot_quick_one_default"
                android:textAllCaps="false"
                android:textColor="@color/wofertas_blue_primary"
                app:cornerRadius="18dp"
                app:strokeColor="@color/wofertas_blue_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickTwo"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:text="@string/chatbot_quick_two_default"
                android:textAllCaps="false"
                android:textColor="@color/wofertas_blue_primary"
                app:cornerRadius="18dp"
                app:strokeColor="@color/wofertas_blue_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickThree"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:text="@string/chatbot_quick_three_default"
                android:textAllCaps="false"
                android:textColor="@color/wofertas_blue_primary"
                app:cornerRadius="18dp"
                app:strokeColor="@color/wofertas_blue_primary" />
        </LinearLayout>
    </HorizontalScrollView>

    <ScrollView
        android:id="@+id/chatScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:importantForAccessibility="no"
        android:overScrollMode="ifContentScrolls"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/quickActionsScroll"
        app:layout_constraintBottom_toTopOf="@id/inputContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/messagesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/inputContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/wofertas_surface"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:hint="@string/chatbot_input_hint"
            app:boxBackgroundMode="filled"
            app:boxBackgroundColor="@color/white"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/wofertas_blue_primary"
            app:hintTextColor="@color/text_primary"
            app:placeholderTextColor="@color/text_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputChatMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSend"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="800"
                android:maxLines="4"
                android:minHeight="48dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <ProgressBar
            android:id="@id/progressChat"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/chatbot_progress_content_description"
            android:indeterminate="true"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendChat"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="54dp"
            android:contentDescription="@string/chatbot_send_content_description"
            android:minWidth="78dp"
            android:text="@string/chatbot_send"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@color/wofertas_blue_primary"
            app:cornerRadius="12dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
