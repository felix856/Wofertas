<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarChatbot"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/wofertas_blue_primary"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/chatbot_title"
        app:titleTextColor="@color/wofertas_yellow"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <HorizontalScrollView
        android:id="@+id/chatbotQuickScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:paddingVertical="8dp"
        android:paddingHorizontal="8dp"
        android:contentDescription="@string/chatbot_quick_questions_content_description"
        app:layout_constraintTop_toBottomOf="@id/toolbarChatbot"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chatbotQuickOne"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/chatbot_quick_one_default"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:cornerRadius="20dp" />

            <Button
                android:id="@+id/chatbotQuickTwo"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:text="@string/chatbot_quick_two_default"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:cornerRadius="20dp" />

            <Button
                android:id="@+id/chatbotQuickThree"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:text="@string/chatbot_quick_three_default"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:cornerRadius="20dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <ScrollView
        android:id="@+id/chatbotScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/chatbotQuickScroll"
        app:layout_constraintBottom_toTopOf="@id/chatbotInputBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/chatbotMessages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp" />
    </ScrollView>

    <ProgressBar
        android:id="@+id/chatbotProgress"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:visibility="gone"
        android:contentDescription="@string/chatbot_progress_content_description"
        app:layout_constraintBottom_toTopOf="@id/chatbotInputBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/chatbotInputBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/wofertas_surface"
        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/chatbotInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/rounded_edittext_background"
            android:hint="@string/chatbot_input_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:paddingHorizontal="14dp"
            android:contentDescription="@string/chatbot_input_content_description" />

        <Button
            android:id="@+id/chatbotSend"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="@string/chatbot_send"
            android:textAllCaps="false"
            android:contentDescription="@string/chatbot_send_content_description"
            app:cornerRadius="12dp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
