<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Ícone PDF -->
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_pdf"
            android:contentDescription="PDF" />

        <!-- Título e data -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/tvEncarteTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Título do encarte"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvEncarteData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2024-01-01"
                android:textSize="12sp"
                android:textColor="@android:color/darker_gray"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Botão Ver -->
        <Button
            android:id="@+id/btnVerEncarte"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ver"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <!-- Botão excluir (visível só para mercado dono) -->
        <ImageButton
            android:id="@+id/btnDeleteEncarte"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Excluir encarte"
            android:visibility="gone" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
