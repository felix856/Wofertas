<?xml version="1.0" encoding="utf-8"?>
<!--
    IDs EXATOS usados por DashboardSupermercadoActivity.kt:
    toolbar_dashboard | tvToolbarTitle | toolbar_logo | fragment_container
    etTituloOferta | etDescricaoOferta | etScheduledDate
    tvPdfName | btnSelectPdf | btnPublishOffer | progressBarUpload
    bottom_navigation_supermercado
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <!-- Toolbar azul organizada: Foto + Wofertas ... Publicar Oferta -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_dashboard"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/wofertas_blue_primary"
        app:title=""
        app:contentInsetStart="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="16dp">

            <!-- Foto de perfil perto de Wofertas -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="34dp"
                android:layout_height="34dp"
                app:cardCornerRadius="17dp"
                app:strokeColor="@color/wofertas_yellow"
                app:strokeWidth="1.5dp"
                app:cardElevation="0dp">
                <ImageView
                    android:id="@+id/toolbar_logo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/perfil"
                    android:contentDescription="Perfil" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Wofertas"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Espaço para afastar o título laranja (conforme solicitado) -->
            <View
                android:layout_width="40dp"
                android:layout_height="0dp" />

            <TextView
                android:id="@+id/tvToolbarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Publicar Oferta"
                android:textColor="@color/wofertas_yellow_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Fragment container — o conteúdo do formulário fica aqui -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar_dashboard"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation_supermercado"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/yellow_light_alpha"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="20dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardInsights"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/wofertas_surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/wofertas_yellow"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="INSIGHTS E DESEMPENHO"
                                    android:textColor="@color/wofertas_blue_primary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvInsightsStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="Carregando metricas do mercado"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <ProgressBar
                                android:id="@+id/progressInsights"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:indeterminate="true" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal"
                            android:weightSum="2">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_field"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Visualizacoes"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvMetricsViews"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="--"
                                    android:textColor="@color/text_primary"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_field"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Interacoes"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvMetricsEngagement"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="--"
                                    android:textColor="@color/text_primary"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal"
                            android:weightSum="2">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_field"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Carrinho"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvMetricsCart"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="--"
                                    android:textColor="@color/text_primary"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_field"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Posicao"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvMetricsRank"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="--"
                                    android:textColor="@color/wofertas_blue_primary"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvInsightsError"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textColor="@color/status_suspenso"
                            android:textSize="12sp"
                            android:visibility="gone"
                            tools:text="Nao foi possivel carregar os insights"
                            tools:visibility="visible" />

                        <Button
                            android:id="@+id/btnVerInsightsDetalhados"
                            style="@style/Btn.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="14dp"
                            android:text="Ver recomendacoes e concorrentes"
                            android:textAllCaps="false" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card: dados da oferta -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_card_white"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp">

                    <TextView
                        style="@style/SectionLabel"
                        android:text="DADOS DA OFERTA"
                        android:textColorHint="@color/darker_gray" />

                    <TextView
                        style="@style/FieldLabel"
                        android:text="Nome / Título" />

                    <EditText
                        android:id="@+id/etTituloOferta"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:autofillHints="name"
                        android:background="@drawable/bg_field"
                        android:gravity="center_vertical"
                        android:hint="Ex.: Encarte Semanal"
                        android:inputType="textCapSentences"
                        android:paddingHorizontal="14dp"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/darker_gray"
                        android:textSize="14sp" />

                    <TextView
                        style="@style/FieldLabel"
                        android:layout_marginTop="12dp"
                        android:text="Status" />

                    <EditText
                        android:id="@+id/etDescricaoOferta"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:autofillHints="none"
                        android:background="@drawable/bg_field"
                        android:gravity="center_vertical"
                        android:hint="ATIVO, SUSPENSO ou EXPIRADO"
                        android:inputType="textCapCharacters"
                        android:paddingHorizontal="14dp"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/darker_gray"
                        android:textSize="14sp" />

                    <TextView
                        style="@style/FieldLabel"
                        android:layout_marginTop="12dp"
                        android:text="Data de validade" />

                    <EditText
                        android:id="@+id/etScheduledDate"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:autofillHints="date"
                        android:background="@drawable/bg_field"
                        android:gravity="center_vertical"
                        android:hint="AAAA-MM-DD"
                        android:inputType="date"
                        android:paddingHorizontal="14dp"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/darker_gray"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- Card: upload do encarte -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_card_white"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp">

                    <TextView
                        style="@style/SectionLabel"
                        android:text="IMAGEM DO ENCARTE"
                        android:textColor="@color/darker_gray"
                        android:textColorHint="@color/darker_gray" />

                    <TextView
                        android:id="@+id/tvPdfName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingVertical="12dp"
                        android:text="Nenhuma imagem selecionada"
                        android:textColor="@color/darker_gray"
                        android:textColorHint="@color/darker_gray"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <ImageView
                        android:id="@+id/ivPreviewDashboard"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginBottom="12dp"
                        android:scaleType="centerInside"
                        android:visibility="gone"
                        tools:visibility="visible"
                        tools:src="@tools:sample/backgrounds/scenic" />

                    <Button
                        android:id="@+id/btnSelectPdf"
                        style="@style/Btn.Outline"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Selecionar Imagem" />

                </LinearLayout>

                <!-- Publicar -->
                <Button
                    android:id="@+id/btnPublishOffer"
                    style="@style/Btn.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Publicar Oferta"
                    android:textSize="16sp" />

                <ProgressBar
                    android:id="@+id/progressBarUpload"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Bottom Nav -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation_supermercado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/wofertas_blue_primary"
        app:itemIconTint="@color/white"
        app:itemTextColor="@color/white"
        app:menu="@menu/bottom_nav_menu_supermercado"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
