<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wofertas_background"
    tools:context=".MinhasOfertas">

    <!-- Toolbar com botão “voltar” -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_minhas_ofertas"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/wofertas_blue_primary"
        app:title="Ofertas Disponíveis"
        app:titleTextColor="@color/white"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ProgressBar para indicar carregamento (posicionada acima do RecyclerView para visibilidade) -->
    <ProgressBar
        android:id="@+id/progressBarMinhasOfertas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_minhas_ofertas" />

    <!-- TextView para mensagens de status (nenhuma oferta, erro, etc.) -->
    <TextView
        android:id="@+id/tvMinhasOfertasMessage"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Buscando ofertas..."
    android:textColor="@color/darker_gray"
    android:textSize="18sp"
    android:visibility="gone"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/toolbar_minhas_ofertas" />

    <!-- RecyclerView que exibirá as ofertas -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewMinhasOfertas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_minhas_ofertas"
        app:layout_constraintBottom_toTopOf="@+id/bottom_navigation_supermercado"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_oferta" />

    <!-- BottomNavigationView para navegação do supermercado (Dashboard / Minhas Ofertas / Criar Oferta / Perfil) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation_supermercado"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:background="@color/wofertas_blue_primary"
    app:itemIconTint="@color/white"
    app:itemTextColor="@color/white"
    app:menu="@menu/dashboard_menu"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
