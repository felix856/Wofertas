<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_perfil"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_salvos_bg">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_perfil"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/wofertas_blue_primary"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Meu Perfil"
        app:titleTextColor="@color/wofertas_yellow"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/llPerfilHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@color/wofertas_blue_primary"
        android:paddingTop="16dp"
        android:paddingBottom="28dp"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar_perfil"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imageViewAvatar"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_avatar"
            android:padding="3dp"
            android:contentDescription="Avatar"
            tools:src="@drawable/perfil" />

        <TextView
            android:id="@+id/textViewNomePerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            tools:text="Nome do Usuário" />

        <TextView
            android:id="@+id/textViewEmailPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/wofertas_yellow_light"
            android:textSize="13sp"
            android:layout_marginTop="2dp"
            tools:text="usuario@email.com" />

    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/llPerfilHeader"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_white"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:elevation="2dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONTA"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnEditarPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Editar Perfil e Localização"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:visibility="gone"
                    app:backgroundTint="@color/wofertas_blue_primary"
                    app:cornerRadius="10dp"
                    android:stateListAnimator="@null"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnTrocarSenha"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Trocar Senha"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:backgroundTint="@color/wofertas_blue_primary"
                    app:cornerRadius="10dp"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btnPrivacidade"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="Privacidade e LGPD"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:backgroundTint="@color/wofertas_blue_primary"
                    app:cornerRadius="10dp"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btnSolicitarExclusao"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="Solicitar exclusao da conta"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/status_suspenso"
                    app:cornerRadius="10dp"
                    android:stateListAnimator="@null" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:elevation="2dp">

                <Button
                    android:id="@+id/btnSair"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Sair da conta"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/status_suspenso"
                    app:cornerRadius="10dp"
                    android:stateListAnimator="@null" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/wofertas_blue_primary"
        app:itemIconTint="@color/white"
        app:itemTextColor="@color/white"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
