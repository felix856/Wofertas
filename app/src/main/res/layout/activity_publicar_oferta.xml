<?xml version="1.0" encoding="utf-8"?>
<!--
    IDs preservados: toolbar_publicar_oferta | etNomeOfertaPublicar | etStatusOfertaPublicar
    tvDataInicioPublicar | tvDataFimPublicar | btnSelecionarDataInicio | btnSelecionarDataFim
    tvImagemNomePublicar | btnSelecionarImagemPublicar | ivPreviewPublicar
    progressBarPublicar | btnPublicarOfertaSubmit
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/yellow_light_alpha">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_publicar_oferta"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/wofertas_blue_primary"
        app:title="Publicar Oferta"
        app:titleTextColor="@color/white"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Card: Dados da oferta -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_white"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"
                android:elevation="2dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DADOS DA OFERTA"
                    style="@style/SectionLabel" />

                <!-- Nome -->
                <TextView style="@style/FieldLabel" android:text="Nome da Oferta *" />

                <EditText
                    android:id="@+id/etNomeOfertaPublicar"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_field"
                    android:hint="Ex: Frango a R$ 9,99/kg"
                    android:inputType="textCapSentences"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="14sp"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:layout_marginBottom="14dp" />

                <!-- Status -->
                <TextView style="@style/FieldLabel" android:text="Status" />

                <EditText
                    android:id="@+id/etStatusOfertaPublicar"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_field"
                    android:hint="ATIVO ou INATIVO"
                    android:inputType="textCapCharacters"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="14sp"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:layout_marginBottom="8dp" />

            </LinearLayout>

            <!-- Card: Datas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_white"
                android:elevation="2dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PERÍODO"
                    style="@style/SectionLabel"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp" />

                <!-- Linha: Data de Início -->
                <LinearLayout
                    android:id="@+id/btnSelecionarDataInicio"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Data de Início *"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tvDataInicioPublicar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Não selecionada"
                            android:textSize="14sp"
                            android:textColor="@color/text_hint"
                            android:layout_marginTop="1dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📅"
                        android:textSize="20sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginHorizontal="16dp" />

                <!-- Linha: Data de Fim -->
                <LinearLayout
                    android:id="@+id/btnSelecionarDataFim"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Data de Fim"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tvDataFimPublicar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Não selecionada"
                            android:textSize="14sp"
                            android:textColor="@color/text_hint"
                            android:layout_marginTop="1dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📅"
                        android:textSize="20sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Card: Imagem -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_white"
                android:elevation="2dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IMAGEM DA OFERTA"
                    style="@style/SectionLabel"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp" />

                <!-- Preview da imagem (visível após selecionar) -->
                <ImageView
                    android:id="@+id/ivPreviewPublicar"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="8dp" />

                <!-- Linha clicável para selecionar imagem -->
                <LinearLayout
                    android:id="@+id/btnSelecionarImagemPublicar"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Selecionar imagem"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/tvImagemNomePublicar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nenhuma imagem selecionada"
                            android:textSize="12sp"
                            android:textColor="@color/text_hint"
                            android:layout_marginTop="1dp"
                            android:singleLine="true"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🖼️"
                        android:textSize="20sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- ProgressBar -->
            <ProgressBar
                android:id="@+id/progressBarPublicar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <!-- Botão Publicar -->
            <Button
                android:id="@+id/btnPublicarOfertaSubmit"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Publicar Oferta"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/wofertas_blue_primary"
                app:cornerRadius="12dp"
                android:stateListAnimator="@null" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>