<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yellow_light_alpha"
    android:orientation="vertical">

    <!-- Toolbar azul -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_editar_perfil"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/wofertas_blue_primary"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Editar Perfil"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="28dp">

            <!-- Avatar / Logo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnTrocarFoto"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    app:cardCornerRadius="45dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/wofertas_yellow"
                    app:strokeWidth="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/imgPerfilEditar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Foto de perfil ou logo"
                        android:scaleType="centerCrop"
                        android:src="@drawable/logo_supermercado_placeholder" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Toque para alterar"
                    android:textColor="@color/wofertas_blue_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Card: dados -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_white"
                android:elevation="2dp"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp">

                <TextView
                    style="@style/SectionLabel"
                    android:text="DADOS BÁSICOS"
                    android:textColor="@color/black" />

                <TextView
                    style="@style/FieldLabel"
                    android:text="Nome" />

                <EditText
                    android:id="@+id/editNome"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_field"
                    android:gravity="center_vertical"
                    android:hint="Seu nome ou do mercado"
                    android:inputType="textPersonName|textCapWords"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    style="@style/FieldLabel"
                    android:layout_marginTop="14dp"
                    android:text="Endereço completo" />

                <EditText
                    android:id="@+id/editEndereco"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_field"
                    android:gravity="center_vertical"
                    android:hint="Rua, número, bairro, cidade"
                    android:inputType="textPostalAddress|textCapWords"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="SEGURANÇA"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:letterSpacing="0.06"
                    android:textColor="@color/black" />

                <EditText
                    android:id="@+id/etNovaSenha"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_field"
                    android:hint="Nova Senha (vazio para manter)"
                    android:inputType="textPassword"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSalvar"
                style="@style/Btn.Primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Salvar Alterações" />

            <ProgressBar
                android:id="@+id/progressBarEditar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <!-- Divisor -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnSairPerfil"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Sair da conta"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/status_suspenso"
                app:cornerRadius="12dp"
                android:stateListAnimator="@null" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
