<?xml version="1.0" encoding="utf-8"?>
<!--
    bottom_sheet_mercado.xml
    Exibido quando o usuário toca em um marcador no mapa.
    Mostra: nome, endereço, telefone do mercado + lista de ofertas ativas.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@android:color/white">

    <!-- Indicador de drag -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#CCCCCC" />

    <!-- Nome do mercado -->
    <TextView
        android:id="@+id/tvBsMercadoNome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nome do Mercado"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#1A1A2E"
        android:layout_marginBottom="4dp" />

    <!-- Endereço -->
    <TextView
        android:id="@+id/tvBsMercadoEndereco"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📍 Endereço"
        android:textSize="14sp"
        android:textColor="#555555"
        android:layout_marginBottom="4dp" />

    <!-- Telefone -->
    <TextView
        android:id="@+id/tvBsMercadoTelefone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#555555"
        android:layout_marginBottom="12dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginBottom="12dp" />

    <!-- Label ofertas -->
    <TextView
        android:id="@+id/tvBsOfertasLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ofertas ativas:"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#1A1A2E"
        android:layout_marginBottom="8dp" />

    <!-- Lista de nomes de ofertas -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBsOfertas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="180dp"
        android:nestedScrollingEnabled="false"
        android:layout_marginBottom="16dp" />

    <!-- Botão ver lista completa -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBsVerOfertas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ver Todas as Ofertas"
        app:backgroundTint="@color/wofertas_blue_primary"
        android:layout_marginBottom="8dp" />

</LinearLayout>
